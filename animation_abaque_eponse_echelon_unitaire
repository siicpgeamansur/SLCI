<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Réponse indicielle du second ordre</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,600;1,400&display=swap">
<style>
/* Mise en page à la GeoGebra : volet « Algèbre » à gauche (curseur ξ et valeurs), deux vues graphiques à droite sur fond blanc.
   Sur écran étroit, le volet passe au-dessus et les graphiques s'empilent. */
:root {
  --bg: #ffffff;
  --panel: #ffffff;
  --head: #f4f4f6;
  --fg: #212121;
  --muted: #666b75;
  --rule: #cfd1d6;
  --grid: #d6d8dd;
  --grid-minor: #eceef1;
  --axis: #2b2b2b;
  --ui: #6557d2;
  --curve: #1565c0;
  --band: #d32f2f;
  --font: 'Open Sans', system-ui, -apple-system, 'Segoe UI', Arial, sans-serif;
  color-scheme: light;
}

* { box-sizing: border-box; }
body {
  background: var(--bg);
  color: var(--fg);
  font-family: var(--font);
  font-size: 14px;
  line-height: 1.5;
  padding-block: 0 28px;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
.wrap { max-width: 1320px; margin: 0 auto; }

header {
  display: flex;
  align-items: baseline;
  gap: 8px 18px;
  flex-wrap: wrap;
  padding: 14px 0 12px;
  border-bottom: 1px solid var(--rule);
  margin-bottom: 14px;
}
header h1 { margin: 0; font-size: 1.15rem; font-weight: 600; }
header p { margin: 0; color: var(--muted); font-style: italic; overflow-wrap: anywhere; }

.app { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 14px; align-items: start; }

.view { background: var(--panel); border: 1px solid var(--rule); border-radius: 4px; overflow: hidden; min-width: 0; }
.view > h2, .tab {
  margin: 0;
  padding: 7px 12px;
  background: var(--head);
  border-bottom: 1px solid var(--rule);
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--fg);
}

/* Volet Algèbre */
.item { display: flex; gap: 12px; padding: 12px 14px; border-bottom: 1px solid var(--grid-minor); }
.dot { flex: none; width: 14px; height: 14px; border-radius: 50%; margin-top: 5px; background: var(--ui); border: 2px solid var(--panel); box-shadow: 0 0 0 1px var(--ui); }
.dot.blue { background: var(--curve); box-shadow: 0 0 0 1px var(--curve); }
.dot.red { background: var(--band); box-shadow: 0 0 0 1px var(--band); }
.dot.grey { background: var(--muted); box-shadow: 0 0 0 1px var(--muted); }
.item .body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
.eq { display: flex; align-items: center; gap: 8px; }
.eq label { font-style: italic; font-size: 1.05rem; }
.eq input[type="number"] {
  width: 6.5rem;
  font: inherit;
  font-size: 1.05rem;
  color: var(--fg);
  background: var(--panel);
  border: 0;
  border-bottom: 1px solid var(--rule);
  border-radius: 0;
  padding: 2px 4px;
  font-variant-numeric: tabular-nums;
}
.eq input[type="number"]:focus { border-bottom: 2px solid var(--ui); outline: none; padding-bottom: 1px; }

input[type="range"] { -webkit-appearance: none; appearance: none; width: 100%; height: 22px; background: transparent; margin: 0; cursor: pointer; }
input[type="range"]::-webkit-slider-runnable-track { height: 3px; background: var(--ui); border-radius: 2px; }
input[type="range"]::-moz-range-track { height: 3px; background: var(--ui); border-radius: 2px; }
input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; width: 16px; height: 16px; margin-top: -6.5px; border-radius: 50%; background: var(--ui); border: 2px solid var(--panel); box-shadow: 0 0 0 1px var(--ui); }
input[type="range"]::-moz-range-thumb { width: 12px; height: 12px; border-radius: 50%; background: var(--ui); border: 2px solid var(--panel); box-shadow: 0 0 0 1px var(--ui); }
input:focus-visible, button:focus-visible { outline: 2px solid var(--ui); outline-offset: 2px; }

.scale { display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--muted); margin-top: -6px; font-variant-numeric: tabular-nums; }
.presets { display: flex; flex-wrap: wrap; gap: 6px; }
.presets button {
  font: inherit;
  font-size: 0.8rem;
  color: var(--fg);
  background: var(--panel);
  border: 1px solid var(--rule);
  border-radius: 4px;
  padding: 2px 10px;
  cursor: pointer;
  font-variant-numeric: tabular-nums;
}
.presets button:hover { background: var(--head); }
.presets button[aria-pressed="true"] { background: var(--ui); border-color: var(--ui); color: #fff; }

.line { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px; }
.line .k { color: var(--muted); }
.line .v { font-weight: 600; font-variant-numeric: tabular-nums; }
.note { margin: 0; padding: 12px 14px; color: var(--muted); font-size: 0.82rem; }

/* Vues graphiques */
.charts { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 14px; min-width: 0; }
figure.view { margin: 0; display: flex; flex-direction: column; }
.plot { min-width: 0; padding: 6px 8px 0; }
.plot svg { display: block; width: 100%; height: auto; overflow: visible; }
figcaption { color: var(--muted); font-size: 0.8rem; padding: 4px 12px 10px; text-wrap: pretty; }

/* SVG */
svg text { font-family: var(--font); font-size: 12px; fill: var(--fg); }
svg .axis-title { font-size: 13px; font-style: italic; }
svg .tick-label { fill: var(--muted); }
svg .g-major { stroke: var(--grid); stroke-width: 1; }
svg .g-minor { stroke: var(--grid-minor); stroke-width: 1; }
svg .axis { stroke: var(--axis); stroke-width: 1.4; }
svg .arrow { fill: var(--axis); }
svg .ref { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 5 4; opacity: 0.7; }
svg .curve { fill: none; stroke: var(--curve); stroke-width: 2.4; stroke-linejoin: round; }
svg .band-line { stroke: var(--band); stroke-width: 1.5; stroke-dasharray: 6 4; }
svg .band-fill { fill: var(--band); opacity: 0.06; }
svg .tr-line { stroke: var(--band); stroke-width: 1.8; }
svg .tr-dot { fill: var(--band); stroke: var(--panel); stroke-width: 2; }
svg .cur-line { stroke: var(--ui); stroke-width: 1.8; stroke-dasharray: 5 4; }
svg .cur-dot { fill: var(--ui); stroke: var(--panel); stroke-width: 2; }
svg .tr-label { fill: var(--band); }
svg .pt-label { fill: var(--ui); font-weight: 600; }

@media (max-width: 1100px) {
  .app { grid-template-columns: minmax(0, 1fr); }
}
@media (max-width: 800px) {
  .charts { grid-template-columns: minmax(0, 1fr); }
}
@media (max-width: 440px) {
  .eq input[type="number"] { width: 5.6rem; }
}
</style>

<div class="wrap">
  <header>
    <h1>Réponse indicielle du second ordre</h1>
    <p>H(p) = K / (1 + (2ξ/ω₀)·p + p²/ω₀²)</p>
  </header>

  <div class="app">
    <aside class="view" aria-label="Réglage du coefficient d'amortissement">
      <h2>Algèbre</h2>
      <div class="item">
        <span class="dot" aria-hidden="true"></span>
        <div class="body">
          <div class="eq">
            <label for="z-num">ξ =</label>
            <input type="number" id="z-num" min="0.1" max="10" step="0.01" inputmode="decimal">
          </div>
          <input type="range" id="z-range" min="0" max="1000" step="1" aria-label="Curseur de ξ (échelle logarithmique)">
          <div class="scale" aria-hidden="true"><span>0,1</span><span>1</span><span>10</span></div>
          <div class="presets" id="presets" role="group" aria-label="Valeurs usuelles de ξ"></div>
        </div>
      </div>
      <div aria-live="polite">
        <div class="item"><span class="dot grey" aria-hidden="true"></span><div class="body"><div class="line"><span class="k">Régime</span><span class="v" id="o-regime"></span></div></div></div>
        <div class="item"><span class="dot red" aria-hidden="true"></span><div class="body"><div class="line"><span class="k">Premier dépassement</span><span class="v" id="o-over"></span></div></div></div>
        <div class="item"><span class="dot blue" aria-hidden="true"></span><div class="body"><div class="line"><span class="k"><i>t</i><sub>r5%</sub>·<i>ω</i><sub>0</sub> =</span><span class="v" id="o-tr"></span></div></div></div>
      </div>
      <p class="note">ω₀ = 1 rad/s et K = 1 : le temps est donc en secondes et <i>t</i><sub>r5%</sub>·ω₀ = <i>t</i><sub>r5%</sub>. ξ varie de 0,1 à 10.</p>
    </aside>

    <div class="charts">
      <figure class="view">
        <h2>Graphique 1 : temps de réponse à 5 % réduit</h2>
        <div class="plot" id="plotL"></div>
        <figcaption>Chaque marche correspond à un dépassement de plus qui passe sous la bande ±5 %.</figcaption>
      </figure>
      <figure class="view">
        <h2>Graphique 2 : réponse à un échelon</h2>
        <div class="plot" id="plotR"></div>
        <figcaption>La bande rouge est ±5 % de la valeur finale. La verticale marque la dernière entrée dans cette bande.</figcaption>
      </figure>
    </div>
  </div>
</div>

<script>
(function () {
  var BAND = 0.05, ZMIN = 0.1, ZMAX = 10, EPS = 1e-6;
  var $ = function (id) { return document.getElementById(id); };
  var fmt = function (x, d) { return x.toFixed(d).replace('.', ',').replace('-', '−'); };

  /* Réponse indicielle normalisée S(t)/K, avec ω0 = 1 */
  function step(z, t) {
    if (z < 1 - EPS) {
      var wd = Math.sqrt(1 - z * z);
      return 1 - Math.exp(-z * t) * (Math.cos(wd * t) + z / wd * Math.sin(wd * t));
    }
    if (z > 1 + EPS) {
      var r = Math.sqrt(z * z - 1), p1 = -z + r, p2 = -z - r;
      return 1 - (p2 * Math.exp(p1 * t) - p1 * Math.exp(p2 * t)) / (p2 - p1);
    }
    return 1 - Math.exp(-t) * (1 + t);
  }

  function bisect(g, a, b) { /* g(a) et g(b) de signes opposés */
    var ga = g(a);
    for (var i = 0; i < 70; i++) {
      var m = 0.5 * (a + b), gm = g(m);
      if ((gm > 0) === (ga > 0)) { a = m; ga = gm; } else { b = m; }
    }
    return 0.5 * (a + b);
  }

  /* Temps de réponse à 5 % (ω0 = 1) : dernière entrée dans la bande 1 ± 0,05 */
  function settle(z) {
    var up = function (t) { return step(z, t) - (1 - BAND); };
    if (z < 1 - EPS) {
      var wd = Math.sqrt(1 - z * z);
      var k = Math.floor(Math.log(1 / BAND) * wd / (z * Math.PI));
      if (k >= 1) {
        var f = function (t) { return Math.abs(step(z, t) - 1) - BAND; };
        return bisect(f, k * Math.PI / wd, (k + 1) * Math.PI / wd);
      }
      return bisect(up, 0, Math.PI / wd);
    }
    var b = 1;
    while (up(b) < 0) b *= 2;
    return bisect(up, 0, b);
  }

  /* Courbe de gauche, calculée une fois, avec les sauts placés exactement */
  var curve = (function () {
    var zs = [], N = 1400, i, k;
    for (i = 0; i <= N; i++) zs.push(ZMIN * Math.pow(ZMAX / ZMIN, i / N));
    for (k = 1; k < 60; k++) {
      var a = Math.log(1 / BAND) / (Math.PI * k);
      var zk = a / Math.sqrt(1 + a * a);
      if (zk < ZMIN) break;
      zs.push(zk * (1 - 1e-9), zk * (1 + 1e-9));
    }
    zs.sort(function (p, q) { return p - q; });
    return zs.map(function (z) { return [z, settle(z)]; });
  })();

  function niceCeil(x) {
    var e = Math.pow(10, Math.floor(Math.log10(x))), m = [1, 2, 5, 10];
    for (var i = 0; i < m.length; i++) if (m[i] * e >= x) return m[i] * e;
    return 10 * e;
  }
  function pow10Label(exp) {
    return '10<tspan dy="-5" font-size="9">' + (exp < 0 ? '−' : '') + Math.abs(exp) + '</tspan>';
  }
  function line(cls, x1, y1, x2, y2) {
    return '<line class="' + cls + '" x1="' + x1.toFixed(2) + '" y1="' + y1.toFixed(2) + '" x2="' + x2.toFixed(2) + '" y2="' + y2.toFixed(2) + '"/>';
  }
  function path(pts, X, Y) {
    var d = '';
    for (var i = 0; i < pts.length; i++) d += (i ? 'L' : 'M') + X(pts[i][0]).toFixed(2) + ' ' + Y(pts[i][1]).toFixed(2);
    return d;
  }
  /* Axes à flèche, comme dans GeoGebra : axe x en bas, axe y à gauche */
  function axes(m, pw, ph) {
    var x0 = m.l, y0 = m.t + ph, x1 = m.l + pw, y1 = m.t;
    return line('axis', x0, y0, x1 + 6, y0) + line('axis', x0, y0, x0, y1 - 6) +
      '<polygon class="arrow" points="' + (x1 + 12) + ',' + y0 + ' ' + (x1 + 3) + ',' + (y0 - 4) + ' ' + (x1 + 3) + ',' + (y0 + 4) + '"/>' +
      '<polygon class="arrow" points="' + x0 + ',' + (y1 - 12) + ' ' + (x0 - 4) + ',' + (y1 - 3) + ' ' + (x0 + 4) + ',' + (y1 - 3) + '"/>';
  }

  function drawLeft(z, tr) {
    var host = $('plotL');
    var W = Math.max(260, host.clientWidth - 16), H = Math.round(Math.max(300, W * 0.92));
    var m = { l: 58, r: 22, t: 20, b: 48 }, pw = W - m.l - m.r, ph = H - m.t - m.b;
    var X = function (v) { return m.l + (Math.log10(v) + 1) / 2 * pw; };
    var Y = function (v) { return m.t + (1 - Math.log10(v) / 2) * ph; };
    var s = '', d, k;
    for (d = 0.1; d < 10; d *= 10) for (k = 2; k <= 9; k++) s += line('g-minor', X(d * k), m.t, X(d * k), m.t + ph);
    for (d = 1; d < 100; d *= 10) for (k = 2; k <= 9; k++) s += line('g-minor', m.l, Y(d * k), m.l + pw, Y(d * k));
    [0.1, 1, 10].forEach(function (v) { s += line('g-major', X(v), m.t, X(v), m.t + ph); });
    [1, 10, 100].forEach(function (v) { s += line('g-major', m.l, Y(v), m.l + pw, Y(v)); });
    s += line('ref', X(1), m.t, X(1), m.t + ph) + line('ref', m.l, Y(10), m.l + pw, Y(10));
    s += '<path class="curve" d="' + path(curve, X, Y) + '"/>';
    s += line('cur-line', X(z), Y(1), X(z), Y(tr));
    s += '<circle class="cur-dot" cx="' + X(z).toFixed(2) + '" cy="' + Y(tr).toFixed(2) + '" r="5.5"/>';
    s += axes(m, pw, ph);
    [-1, 0, 1].forEach(function (e) {
      s += line('axis', X(Math.pow(10, e)), m.t + ph, X(Math.pow(10, e)), m.t + ph + 5);
      s += '<text class="tick-label" x="' + X(Math.pow(10, e)).toFixed(2) + '" y="' + (m.t + ph + 20) + '" text-anchor="middle">' + pow10Label(e) + '</text>';
    });
    [0, 1, 2].forEach(function (e) {
      s += line('axis', m.l - 5, Y(Math.pow(10, e)), m.l, Y(Math.pow(10, e)));
      s += '<text class="tick-label" x="' + (m.l - 9) + '" y="' + (Y(Math.pow(10, e)) + 4).toFixed(2) + '" text-anchor="end">' + pow10Label(e) + '</text>';
    });
    s += '<text class="axis-title" x="' + (m.l + pw / 2) + '" y="' + (H - 6) + '" text-anchor="middle">coefficient d’amortissement ξ</text>';
    s += '<text class="axis-title" transform="translate(15 ' + (m.t + ph / 2) + ') rotate(-90)" text-anchor="middle"><tspan>t</tspan><tspan dy="3" font-size="9">r5%</tspan><tspan dy="-3">·ω</tspan><tspan dy="3" font-size="9">0</tspan></text>';
    host.innerHTML = '<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="Temps de réponse à 5 % réduit en fonction de ξ, pour ξ = ' + fmt(z, 3) + ' : ' + fmt(tr, 2) + '">' + s + '</svg>';
  }

  function drawRight(z, tr) {
    var host = $('plotR');
    var W = Math.max(260, host.clientWidth - 16), H = Math.round(Math.max(290, W * 0.68));
    var m = { l: 50, r: 22, t: 20, b: 48 }, pw = W - m.l - m.r, ph = H - m.t - m.b;
    var tmax = niceCeil(2 * tr), YMAX = 1.8;
    var X = function (t) { return m.l + t / tmax * pw; };
    var Y = function (v) { return m.t + (1 - v / YMAX) * ph; };
    var s = '', i, pts = [], N = 1000;
    for (i = 0; i <= N; i++) { var t = tmax * i / N; pts.push([t, step(z, t)]); }
    for (i = 0; i <= 5; i++) s += line('g-major', X(tmax * i / 5), m.t, X(tmax * i / 5), m.t + ph);
    for (i = 0; i <= 9; i++) s += line(i % 1 === 0 ? 'g-major' : 'g-minor', m.l, Y(0.2 * i), m.l + pw, Y(0.2 * i));
    s += '<rect class="band-fill" x="' + m.l + '" y="' + Y(1 + BAND).toFixed(2) + '" width="' + pw + '" height="' + (Y(1 - BAND) - Y(1 + BAND)).toFixed(2) + '"/>';
    s += line('band-line', m.l, Y(1 + BAND), m.l + pw, Y(1 + BAND)) + line('band-line', m.l, Y(1 - BAND), m.l + pw, Y(1 - BAND));
    s += '<clipPath id="clipR"><rect x="' + m.l + '" y="' + m.t + '" width="' + pw + '" height="' + ph + '"/></clipPath>';
    s += '<path class="curve" clip-path="url(#clipR)" d="' + path(pts, X, Y) + '"/>';
    var sTr = step(z, tr);
    s += line('tr-line', X(tr), Y(0), X(tr), Y(sTr));
    s += '<circle class="tr-dot" cx="' + X(tr).toFixed(2) + '" cy="' + Y(sTr).toFixed(2) + '" r="5"/>';
    s += '<text class="tr-label" x="' + (X(tr) + 8).toFixed(2) + '" y="' + (Y(0) - 8) + '"><tspan font-style="italic">t</tspan><tspan dy="3" font-size="9">r5%</tspan><tspan dy="-3"> = ' + fmt(tr, 1) + ' s</tspan></text>';
    s += axes(m, pw, ph);
    for (i = 0; i <= 5; i++) {
      var tv = tmax * i / 5;
      s += line('axis', X(tv), m.t + ph, X(tv), m.t + ph + 5);
      s += '<text class="tick-label" x="' + X(tv).toFixed(2) + '" y="' + (m.t + ph + 20) + '" text-anchor="middle">' + fmt(tv, tv % 1 ? 1 : 0) + '</text>';
    }
    for (i = 0; i <= 9; i++) {
      s += line('axis', m.l - 5, Y(0.2 * i), m.l, Y(0.2 * i));
      s += '<text class="tick-label" x="' + (m.l - 9) + '" y="' + (Y(0.2 * i) + 4).toFixed(2) + '" text-anchor="end">' + fmt(0.2 * i, 1) + '</text>';
    }
    s += '<text class="axis-title" x="' + (m.l + pw / 2) + '" y="' + (H - 6) + '" text-anchor="middle">temps <tspan>t</tspan> en s</text>';
    s += '<text class="axis-title" transform="translate(14 ' + (m.t + ph / 2) + ') rotate(-90)" text-anchor="middle">S(<tspan>t</tspan>) / K</text>';
    host.innerHTML = '<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="Réponse indicielle S(t)/K pour ξ = ' + fmt(z, 3) + '">' + s + '</svg>';
  }

  /* État et commandes */
  var z = 0.13;
  var range = $('z-range'), num = $('z-num');
  var PRESETS = [0.13, 0.3, 0.5, 0.7, 1, 2, 5];
  var presetsEl = $('presets');
  PRESETS.forEach(function (p) {
    var b = document.createElement('button');
    b.type = 'button';
    b.textContent = fmt(p, p < 1 ? 2 : 0);
    b.dataset.z = p;
    b.addEventListener('click', function () { setZ(p, 'preset'); });
    presetsEl.appendChild(b);
  });

  function zToSlider(v) { return Math.round((Math.log10(v) + 1) / 2 * 1000); }
  function sliderToZ(v) { return Math.round(Math.pow(10, -1 + 2 * v / 1000) * 1000) / 1000; }

  function render() {
    var tr = settle(z);
    $('o-regime').textContent = z < 1 - 1e-9 ? 'pseudo-périodique' : (Math.abs(z - 1) < 1e-9 ? 'critique' : 'apériodique');
    $('o-over').textContent = z < 1 ? fmt(Math.exp(-Math.PI * z / Math.sqrt(1 - z * z)) * 100, 1) + ' %' : 'aucun';
    $('o-tr').textContent = fmt(tr, 2);
    Array.prototype.forEach.call(presetsEl.children, function (b) {
      b.setAttribute('aria-pressed', Math.abs(parseFloat(b.dataset.z) - z) < 1e-9 ? 'true' : 'false');
    });
    drawLeft(z, tr);
    drawRight(z, tr);
  }

  function setZ(v, source) {
    z = Math.min(ZMAX, Math.max(ZMIN, v));
    if (source !== 'range') range.value = zToSlider(z);
    if (source !== 'num') num.value = String(z);
    render();
  }

  range.addEventListener('input', function () { setZ(sliderToZ(parseFloat(range.value)), 'range'); num.value = String(z); });
  num.addEventListener('input', function () {
    var v = parseFloat(num.value);
    if (isFinite(v) && v >= ZMIN && v <= ZMAX) setZ(v, 'num');
  });
  num.addEventListener('change', function () {
    var v = parseFloat(num.value);
    setZ(isFinite(v) ? v : z, 'preset');
  });

  var pending = false;
  function onResize() {
    if (pending) return;
    pending = true;
    requestAnimationFrame(function () { pending = false; render(); });
  }
  if (window.ResizeObserver) {
    var ro = new ResizeObserver(onResize);
    ro.observe($('plotL')); ro.observe($('plotR'));
  } else {
    window.addEventListener('resize', onResize);
  }

  setZ(z, 'init');
})();
</script>

